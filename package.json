{
  "name": "free-steam-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:icon": "node scripts/create-desktop-icon.mjs",
    "desktop:dist": "npm run desktop:icon && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3",
    "png-to-ico": "^2.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.freesteamgame.desktop",
    "productName": "Free Steam Game",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Free Steam Game",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}